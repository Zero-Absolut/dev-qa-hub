<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <title>Resultados de Perguntas — Dev Q&A Hub</title>

    <style>
        :root {
            --primary: #6366f1;
            --accent: #0ea5e9;
            --light: #f8fafc;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #f1f5f9;
        }

        .navbar {
            box-shadow: 0 2px 15px rgba(0,0,0,0.06);
        }

        /* Cards de perguntas */
        .question-card {
            border: none;
            border-radius: 14px;
            padding: 20px;
            background: white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transform: skewX(-2deg);
            transition: 0.3s;
            border-left: 6px solid var(--primary);
        }

        .question-card > * {
            transform: skewX(2deg);
        }

        .question-card:hover {
            transform: translateY(-6px) skewX(-2deg);
            box-shadow: 0 12px 32px rgba(0,0,0,0.15);
        }

        .badge-tag {
            display: inline-block;
            background: #e2e8f0;
            padding: 5px 10px;
            border-radius: 50px;
            font-size: 0.85rem;
            color: #334155;
            margin-right: 6px;
            text-decoration: none;
            transition: .2s;
        }

        .badge-tag:hover {
            background: var(--primary);
            color: white;
        }

        /* Sidebar */
        .sidebar-card {
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.1);
        }

        .badge-tag-sidebar {
            text-decoration: none;
            color: var(--primary);
            font-weight: 600;
        }

        .badge-tag-sidebar:hover {
            text-decoration: underline;
        }

        /* Paginação */
        .pagination-container {
            display: flex;
            justify-content: center;
            margin-top: 30px;
        }

    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold text-primary" href="/index">Dev Q&A Hub</a>
        </div>
    </nav>

    <!-- Conteúdo Principal -->
    <main class="container mt-5">
        <div class="row">

            <!-- Coluna principal: resultados -->
            <div class="col-lg-8">

                <h2 class="mb-4 fw-bold">Resultados da Busca</h2>

            <% if (perguntasBuscadas.length > 0) { %>
                <% perguntasBuscadas.forEach(perguntaFiltrada => { %>
                    <div class="question-card mb-3">
                        <h5>
                            <a href="#" class="text-primary text-decoration-none">
                                <%= perguntaFiltrada.title %>
                            </a>
                        </h5>
                        <p class="text-muted mt-2"><%= perguntaFiltrada.pergunta %></p>
                        <div>
                            <a href="#" class="badge-tag">#react</a>
                            <a href="#" class="badge-tag">#cors</a>
                            <a href="#" class="badge-tag">#javascript</a>
                        </div>
                        <small class="text-muted d-block mt-2">
                            Postada por <%= perguntaFiltrada.usuario.nome %> em 
                            <%= new Date(perguntaFiltrada.createdAt).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                        </small>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="alert alert-info">
                    <%= msgErroPesquisa || "Nenhuma pergunta encontrada." %>
                </div>
            <% } %>


                <!-- Paginação -->
                <nav class="pagination-container">
                    <ul class="pagination">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Anterior</a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Próximo</a>
                        </li>
                    </ul>
                </nav>

            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card sidebar-card mb-4">
                    <div class="card-header bg-primary text-white fw-semibold">Tags em Tendência</div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="#" class="badge-tag-sidebar">#javascript</a>
                            <span class="badge bg-light text-dark">508</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="#" class="badge-tag-sidebar">#python</a>
                            <span class="badge bg-light text-dark">312</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="#" class="badge-tag-sidebar">#html-css</a>
                            <span class="badge bg-light text-dark">156</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="#" class="badge-tag-sidebar">#nodejs</a>
                            <span class="badge bg-light text-dark">78</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="#" class="badge-tag-sidebar">#databases</a>
                            <span class="badge bg-light text-dark">52</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-5 py-4 text-center border-top">
        <p class="mb-1 text-muted">&copy; 2025 Dev Q&A Hub — Todos os direitos reservados.</p>
    </footer>

    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
