<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <title>Dev Q&A Hub</title>

    <style>
        :root {
            --primary: #6366f1;
            --accent: #0ea5e9;
            --dark: #0f172a;
            --light: #f8fafc;
        }

        body {
            background: #f1f5f9;
            font-family: "Inter", sans-serif;
        }

        /* NAVBAR */
        .navbar {
            box-shadow: 0 2px 15px rgba(0,0,0,0.06);
        }

        /* HERO ASSIMÉTRICO */
        .hero-section {
            position: relative;
            padding: 120px 0;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white;
            overflow: hidden;
        }

        .hero-section::before {
            content: "";
            position: absolute;
            bottom: -80px;
            left: -10%;
            width: 130%;
            height: 160px;
            background: white;
            transform: skewY(-8deg);
            box-shadow: 0 -10px 25px rgba(0,0,0,0.15);
        }

        .hero-section .container {
            position: relative;
            z-index: 5;
        }

        .hero-section h1 {
            font-weight: 800;
            font-size: 3rem;
        }

        /* PERGUNTAS */
        .question-card {
            border: none;
            border-radius: 14px;
            padding: 20px;
            background: white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transform: skewX(-2deg);
            transition: 0.3s;
            border-left: 6px solid var(--primary);
        }

        .question-card > * {
            transform: skewX(2deg);
        }

        .question-card:hover {
            transform: translateY(-6px) skewX(-2deg);
            box-shadow: 0 12px 32px rgba(0,0,0,0.15);
        }

        .question-count {
            font-size: 1rem !important;
            padding: 8px 12px;
        }

        .badge-tag {
            display: inline-block;
            background: #e2e8f0;
            padding: 5px 10px;
            border-radius: 50px;
            font-size: 0.85rem;
            color: #334155;
            margin-right: 6px;
            text-decoration: none;
            transition: .2s;
        }

        .badge-tag:hover {
            background: var(--primary);
            color: white;
        }

        /* SIDEBAR */
        .sidebar-card {
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(0,0,0,0.1);
        }

        .badge-tag-sidebar {
            text-decoration: none;
            color: var(--primary);
            font-weight: 600;
        }

        .badge-tag-sidebar:hover {
            text-decoration: underline;
        }

        /* FOOTER */
        footer {
            background: #ffffff;
            box-shadow: 0 -3px 20px rgba(0,0,0,0.05);
        }

    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold text-primary" href="/index">Dev Q&A Hub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <form class="d-flex mx-auto" style="max-width: 400px;" method="post" action="/pesquisar">
                    <input class="form-control me-2" type="search" placeholder="Pesquisar perguntas..." name="pesquisaPergunta">
                    <button type="submit" class="btn btn-outline-primary">Buscar</button>
                </form>

                <ul class="navbar-nav ms-auto align-items-lg-center">
                    
                    
                    
                     
                    <% if(req.session && req.session.isAuthenticated === true){  %>
                        <li class="nav-item me-3 mt-2 mt-lg-0">
                            <span class="navbar-text text-dark fw-semibold">
                                Olá, <%= req.session.userName %>! 
                            </span>
                        </li>
                        
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <form action="/logout" method="POST" style="display: inline;">
                                <button type="submit" class="btn btn-danger">Sair</button>
                            </form>
                        </li>
                    <%} else { %>
                        <li class="nav-item"><a class="nav-link active" href="/login">Login</a></li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a class="btn btn-primary" href="/form-cadastro">Cadastrar</a>
                        </li>
                    <%}%>
                </ul>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero-section text-center">
        <div class="container">
            <h1>Desbloqueie Conhecimento</h1>
            <p class="fs-5 mt-2">A comunidade para perguntas e respostas de desenvolvedores</p>

            <div class="mt-4">
                <a href="/perguntar" class="btn btn-light btn-lg me-2">Fazer uma Pergunta</a>
                <a href="/topicos" class="btn btn-outline-light btn-lg">Explorar Tópicos</a>
            </div>
        </div>
    </section>

           <main class="container mt-5">
    <div class="row">

        <!-- LISTA DE PERGUNTAS -->
        <div class="col-lg-8">
            <h2 class="mb-4 fw-bold">Perguntas Recentes</h2>

            <% perguntas.forEach(pergunta => { %>
                <div class="card question-card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5>
                                <a href="/detalhesPergunta?id=<%= pergunta.id %>" 
                                    class="text-primary text-decoration-none">
                                    <%= pergunta.title %>
                                </a>

                            </h5>
                        </div>
                        <p class="text-muted"><%= pergunta.pergunta %></p>
                        <div>
                            <a href="#" class="badge-tag">#react</a>
                            <a href="#" class="badge-tag">#cors</a>
                            <a href="#" class="badge-tag">#javascript</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- SIDEBAR -->
            <div class="col-lg-4">
                <div class="card sidebar-card mb-4 mt-lg-5">
                    <div class="card-header bg-primary text-white fw-semibold">
                        Como participar
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            📌 Faça perguntas claras e objetivas
                        </li>
                        <li class="list-group-item">
                            🧠 Inclua detalhes do problema e o que já tentou
                        </li>
                        <li class="list-group-item">
                            💬 Responda outras perguntas da comunidade
                        </li>
                        <li class="list-group-item">
                            👍 Seja educado e respeitoso
                        </li>
                        <li class="list-group-item">
                            🚀 Ajude outros devs a evoluir
                        </li>
                    </ul>
                </div>

                <div class="card sidebar-card">
                    <div class="card-body text-center">
                        <p class="fw-semibold mb-2">Novo por aqui?</p>
                        <a href="/form-cadastro" class="btn btn-outline-primary btn-sm w-100">
                            Criar conta
                        </a>
                    </div>
                </div>
            </div>

    </div>
</main>


    <!-- FOOTER -->
    <footer class="mt-5 py-4 text-center border-top">
        <p class="mb-1 text-muted">&copy; <span id="currentYear"></span> Dev Q&A Hub — Todos os direitos reservados.</p>
        <a href="#" class="text-primary text-decoration-none me-3">Sobre</a>
        <a href="#" class="text-primary text-decoration-none me-3">Contato</a>
        <a href="#" class="text-primary text-decoration-none">Política de Privacidade</a>
    </footer>

    <script>
        document.getElementById("currentYear").textContent = new Date().getFullYear();
    </script>
</body>
</html>
