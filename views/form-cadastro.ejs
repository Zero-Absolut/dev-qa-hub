<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <title>Cadastro - Dev Q&A Hub</title>

    <style>
        :root {
            --primary: #6366f1;
            --accent: #0ea5e9;
            --dark: #0f172a;
            --light: #f8fafc;
        }

        body {
            background: #f1f5f9;
            font-family: "Inter", sans-serif;
        }

        /* NAVBAR */
        .navbar {
            box-shadow: 0 2px 15px rgba(0,0,0,0.06);
        }

        /* HERO */
        .hero-section {
            position: relative;
            padding: 90px 0;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: white;
            text-align: center;
            overflow: hidden;
        }

        .hero-section::after {
            content: "";
            position: absolute;
            bottom: -70px;
            left: -10%;
            width: 130%;
            height: 150px;
            background: #f1f5f9;
            transform: skewY(-8deg);
            box-shadow: 0 -8px 25px rgba(0,0,0,0.18);
        }

        .hero-section h1 {
            font-weight: 800;
        }

        /* CARD DE CADASTRO */
        .register-card {
            background: white;
            border-radius: 18px;
            padding: 35px;
            margin-top: -60px;
            max-width: 520px;
            width: 100%;
            box-shadow: 0 6px 25px rgba(0,0,0,0.12);
            transform: skewX(-2deg);
        }

        .register-card > * {
            transform: skewX(2deg);
        }

        .register-card label {
            font-weight: 600;
            margin-bottom: 4px;
            color: #334155;
        }

        .register-card input {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px;
            transition: .2s;
        }

        .register-card input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99,102,241,0.3);
        }

        .btn-primary-mod {
            background: var(--primary);
            border: none;
            padding: 12px;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            width: 100%;
        }

        .btn-primary-mod:hover {
            background: var(--accent);
            transform: translateY(-2px);
        }

        .form-check-label {
            font-size: 0.9rem;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold text-primary" href="/index">Dev Q&A Hub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero-section">
        <div class="container">
            <h1>Crie sua Conta</h1>
            <p class="fs-5 mt-2">Participe da comunidade e compartilhe conhecimento</p>
        </div>
    </section>

    <!-- FORMULÁRIO DE CADASTRO -->
    <main class="container d-flex justify-content-center">
        <div class="register-card">

            <h3 class="text-center text-dark fw-bold mb-4">Cadastro</h3>

            <form action="/form-cadastro" method="POST">

                <!-- NOME -->
                <label for="nome">Nome Completo</label>
                <input type="text" id="nome" name="nome" class="form-control"
                    placeholder="Digite seu nome completo" required
                    value="<%= typeof oldData !== 'undefined' ? oldData.nome : '' %>">

                <p class="text-danger fw-bold">
                    <% if (typeof erros !== 'undefined') {
                        const nameError = erros.find(err => err.path === 'nome');
                        if (nameError) { %>
                            <%= nameError.msg %>
                    <% }} %>
                </p>

                <!-- EMAIL -->
                <label for="email" class="mt-3">E-mail</label>
                <input type="email" id="email" name="email" class="form-control"
                    placeholder="exemplo@dominio.com" required
                    value="<%= typeof oldData !== 'undefined' ? oldData.email : '' %>">

                <p class="text-danger fw-bold">
                    <% if (typeof erros !== 'undefined') {
                        const emailError = erros.find(err => err.path === 'email');
                        if (emailError) { %>
                            <%= emailError.msg %>
                    <% }} %>
                </p>

                <!-- SENHA -->
                <label for="senha" class="mt-3">Senha</label>
                <input type="password" id="senha" name="senha" class="form-control"
                    placeholder="Crie uma senha segura" required>

                <p class="text-danger fw-bold">
                    <% if (typeof erros !== 'undefined') {
                        const passwordError = erros.find(err => err.path === 'senha');
                        if (passwordError) { %>
                            <%= passwordError.msg %>
                    <% }} %>
                </p>

                <!-- CONFIRMAR SENHA -->
                <label for="confirmacao_senha" class="mt-3">Confirmar Senha</label>
                <input type="password" id="confirmacao_senha" name="confirmacao_senha" class="form-control"
                    placeholder="Repita a senha" required>

                <p class="text-danger fw-bold">
                    <% if (typeof erros !== 'undefined') {
                        const confirmPasswordError = erros.find(err => err.path === 'confirmacao_senha');
                        if (confirmPasswordError) { %>
                            <%= confirmPasswordError.msg %>
                    <% }} %>
                </p>

                <!-- TERMOS -->
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="termos" name="termos" required>
                    <label class="form-check-label text-muted" for="termos">
                        Concordo com os <a href="#" class="text-primary">termos de uso</a>
                    </label>
                </div>

                <p class="text-danger fw-bold">
                    <% if (typeof erros !== 'undefined') {
                        const termoError = erros.find(err => err.path === 'termos');
                        if (termoError) { %>
                            <%= termoError.msg %>
                    <% }} %>
                </p>

                <!-- BOTÃO -->
                <button type="submit" class="btn-primary-mod mt-3">
                    Cadastrar
                </button>

            </form>

            <div class="text-center mt-4">
                <p class="text-muted">Já possui uma conta?
                    <a href="/login" class="text-primary text-decoration-none">Entrar</a>
                </p>
            </div>

        </div>
    </main>

    <footer class="bg-white border-top mt-5 py-4">
        <div class="container text-center">
            <p class="mb-1 text-muted">&copy;<span id="currentYear"></span> Dev Q&A Hub — Todos os direitos reservados.</p>
        </div>
    </footer>

    <script>
        document.getElementById("currentYear").textContent = new Date().getFullYear();
    </script>
</body>
</html>
